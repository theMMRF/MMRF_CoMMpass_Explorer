################## Clinical cleaning for n=1141 ############################
library(dplyr)
library(stringr)
clinical_data <- clinical_data %>%
mutate(
# character cols: trim whitespace and turn "" into NA
across(where(is.character), ~ na_if(str_squish(.), "")),
# factor cols: do the same by round-tripping through character
across(where(is.factor), ~ {
x <- as.character(.)
x <- na_if(str_squish(x), "")
factor(x)
})
)
View(clinical_data)
View(clinical_data)
View(clinical_data)
saveRDS(clinical_data, "clinical_data_n1411.rds")
saveRDS(clinical_data, "clinical_data_n1411.rds")
runApp()
