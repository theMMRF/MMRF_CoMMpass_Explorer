"^TMPRSS13$",   # specific bad actor we saw
"^HRCT",        # HRCT1 etc.
"^HLA",         # often hypermut/misaligned when lots of immune DNA/RNA
"^PABPC1$"      # optional: drop PABPC1 entirely
)
dt3[, drop_family := FALSE]
for (pat in artifact_prefix_regex) {
dt3[grepl(pat, Hugo_Symbol, ignore.case = FALSE), drop_family := TRUE]
}
dt3_keep <- dt3[drop_family == FALSE]
# Rebuild a new maf after removing those families
maf_final2 <- read.maf(
maf = dt3_keep,
verbose = FALSE
)
# Inspect new top recurrent genes
top_genes <- head(getGeneSummary(maf_final2)[order(-MutatedSamples)])
print(top_genes)
## ---- Again ----
# 1. Pull per-gene summary again
gs2 <- data.table(getGeneSummary(maf_final2))
# total # of samples
n_samples2 <- as.numeric(
maf_final2@summary[maf_final2@summary$ID == "Samples", "summary"]
)
# 2. Compute metrics for heuristics
gs2[, alt_frac := MutatedSamples / n_samples2]  # fraction of cohort mutated
gs2[, indel_calls := Frame_Shift_Del + Frame_Shift_Ins + In_Frame_Del + In_Frame_Ins]
gs2[, indel_frac  := ifelse(total > 0, indel_calls / total, 0)]
# 3. Define trusted driver allowlist
driver_allowlist <- c(
"KRAS","NRAS","HRAS","BRAF",
"TP53",
"DIS3","FAM46C","TRAF3","BIRC3","CYLD","SP140",
"MYD88",
"ATM","ATR","BRCA1","BRCA2"
)
# 4. Flag suspicious genes:
#    (A) insanely common (>=30% of samples) and not trusted
# or (B) moderately common (>=15%) AND mostly indel-driven (>=50% indels) and not trusted
gs2[, suspicious := (
(alt_frac >= 0.30 & !(Hugo_Symbol %in% driver_allowlist)) |
(alt_frac >= 0.15 & indel_frac >= 0.50 & !(Hugo_Symbol %in% driver_allowlist))
)]
suspicious_genes <- gs2[suspicious == TRUE, Hugo_Symbol]
suspicious_genes
# 5. Drop those genes at the variant level
dt4 <- data.table::copy(maf_final2@data)
dt4 <- dt4[!(Hugo_Symbol %in% suspicious_genes)]
# 6. Rebuild the final maf
maf_final3 <- read.maf(
maf = dt4,
verbose = FALSE
)
# 7. Inspect final recurrent genes
final_top <- head(getGeneSummary(maf_final3)[order(-MutatedSamples)])
print(final_top)
# visualize overall burden after cleanup
plotmafSummary(maf_final3)
