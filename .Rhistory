blacklist_patterns <- c(
"^IGH", "^IGK", "^IGL",                     # Immunoglobulins (heavy / kappa / lambda)
"^TRAV", "^TRBV", "^TRGV", "^TRDV",         # TCR variable genes
"^TRAC$", "^TRBC", "^TRGC$", "^TRDC$",      # TCR constant/cluster genes
"^KIR",                                     # NK KIR genes
"^HLA-",                                    # HLA genes (highly polymorphic)
"^MT-",                                     # Mitochondrial genes
"^RPL", "^RPS",                             # Ribosomal proteins
"^H[BA][ABDE]",                             # Hemoglobins (HBA/HBB/HBD/HBE/etc.)
"^HIST1", "^HIST2", "^HIST3"                # Histones
)
blacklist_regex <- paste(blacklist_patterns, collapse = "|")
is_blacklisted <- function(genes) grepl(blacklist_regex, genes, perl = TRUE)
filter_gene_list <- function(obj_list,
drop_all_zero = FALSE,
cpm_min = NULL, cpm_min_samples = NULL,
log_min = NULL, log_min_samples = NULL) {
lapply(obj_list, function(m) {
stopifnot(!is.null(rownames(m)))
genes <- rownames(m)
keep <- !is_blacklisted(genes)
# drop genes that are zero across all samples
if (isTRUE(drop_all_zero)) {
keep <- keep & rowSums(m) > 0
}
# expression filters
# keep genes expressed above cpm_min in at least cpm_min_samples
if (!is.null(cpm_min) && !is.null(cpm_min_samples)) {
keep <- keep & (rowSums(m >= cpm_min) >= cpm_min_samples)
}
# For log-normalized matrices: keep genes above log_min in at least log_min_samples
if (!is.null(log_min) && !is.null(log_min_samples)) {
keep <- keep & (rowSums(m >= log_min) >= log_min_samples)
}
m[keep, , drop = FALSE]
})
}
# Counts: blacklist + remove all-zero rows
pseudo_bulk_counts_filt <- filter_gene_list(
pseudo_bulk_counts
)
# CPM: blacklist + CPM >= 1 in >= 5% samples
pseudo_bulk_cpm_filt <- filter_gene_list(
pseudo_bulk_cpm
)
# LogNormalized: blacklist + value >= 0.1 in >= 5% samples
pseudo_bulk_norm_filt <- filter_gene_list(
pseudo_bulk_norm
)
View(pseudo_bulk_counts_filt)
View(pseudo_bulk_counts)
View(pseudo_bulk_cpm_filt)
View(pseudo_bulk_norm_filt)
saveRDS(pseudo_bulk_counts_filt, "data/pseudobulk_data_manuscript_Counts.rds")
saveRDS(pseudo_bulk_norm_filt, "data/pseudobulk_data_manuscript_LogNormalize.rds")
